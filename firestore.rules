rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(db)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{u} {
      allow read: if signedIn() && (request.auth.uid == u || isAdmin());
      allow create: if signedIn() && request.auth.uid == u && request.resource.data.role == 'staff';
      allow update, delete: if isAdmin();
    }
    match /cards/{c} {
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow read, delete: if signedIn() && (resource.data.owner == request.auth.uid || isAdmin());
      allow update: if signedIn() && (resource.data.owner == request.auth.uid || isAdmin())
                    && request.resource.data.owner == resource.data.owner;
    }
    match /settings/{d} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /activity/{a} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }
  }
}
